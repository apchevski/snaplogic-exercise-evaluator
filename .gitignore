# Environment variables
.env
.env.local
.env.*.local

# Project-specific
.tmp/*
!.tmp/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# Per-student grading reports. Cloud runs upload them to S3; this is only
# where a local `python -m evaluator run` writes.
grades/

# Frontend build output (vite; built in CI by deploy-frontend.yml)
frontend/dist/

# Exercise content is authored in the web UI and canonical in S3 (see
# backend/src/content.py), so the per-exercise folders are no longer tracked.
# general_evaluation_rules.md is the exception: it is the judge's universal
# rulebook (read by evaluate.py) and has no S3 uploader or UI editor, so
# git → Docker image is its only delivery path. Ship it or grading applies
# no rules at all.
#
# NOTE: this must be `exercises/*`, not `exercises/` — git does not descend
# into an excluded directory, so a negation under `exercises/` silently
# fails to re-include anything.
exercises/*
!exercises/general_evaluation_rules.md

# Terraform local working dirs (provider binaries); lock files ARE committed
**/.terraform/
# State files (incl. bootstrap's local state) never belong in git
*.tfstate
*.tfstate.backup
infra/environments/*/terraform.tfvars

# Local AI operating instructions (conventions, skills, design notes). Never
# read at runtime and already excluded from the image by .dockerignore.
.claude/
