# .dockerignore for the unified Dockerfile (Lambda image).
# The image carries source + exercises/general_evaluation_rules.md only.
# All other exercise content (authored and generated alike) is canonical in
# S3 and overlaid at run time by S3Store.materialize_exercises.

.env
.env.local
.env.*.local

.git/
.gitignore
.gitattributes
.claude/
.github/

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated/mutable data — produced at run time (S3-materialized on Lambda).
.tmp/
grades/
# Everything under exercises/ except the rulebook the Dockerfile copies by
# name. Do NOT write `exercises/*/` — Docker runs filepath.Clean on each
# pattern, which strips the trailing slash and would exclude the rulebook
# too, breaking the COPY.
exercises/*
!exercises/general_evaluation_rules.md

# Not part of the runtime image.
backend/tests/
frontend/
infra/
docker-compose.yml
Dockerfile
.dockerignore
.vscode/
.idea/
*.swp
